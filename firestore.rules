rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validUsernameDoc() { return request.resource.data.keys().hasOnly(['uid','createdAt']) && request.resource.data.uid == request.auth.uid; }
    function userIs(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName','username','usernameLower','bio','photoURL','photoPath','coverURL','coverPath','category','createdAt','updatedAt','emailVerified','profilePublished','theme','subscriptionStatus','subscriptionPlan'])
        && request.resource.data.username is string && request.resource.data.username.size() >= 3 && request.resource.data.username.size() <= 24
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.photoPath is string && request.resource.data.photoPath.size() <= 240
        && request.resource.data.coverURL is string && request.resource.data.coverURL.size() <= 2048
        && request.resource.data.coverPath is string && request.resource.data.coverPath.size() <= 240
        && request.resource.data.profilePublished == false
        && request.resource.data.subscriptionStatus == 'free' && request.resource.data.subscriptionPlan == 'free';
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','username','usernameLower','bio','photoURL','photoPath','coverURL','coverPath','category','updatedAt','emailVerified','profilePublished','theme'])
        && request.resource.data.username is string && request.resource.data.username.size() >= 3 && request.resource.data.username.size() <= 24
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048))
        && (!('photoPath' in request.resource.data) || (request.resource.data.photoPath is string && request.resource.data.photoPath.size() <= 240))
        && (!('coverURL' in request.resource.data) || (request.resource.data.coverURL is string && request.resource.data.coverURL.size() <= 2048))
        && (!('coverPath' in request.resource.data) || (request.resource.data.coverPath is string && request.resource.data.coverPath.size() <= 240))
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && (!request.resource.data.profilePublished || request.auth.token.email_verified);
      allow delete: if owner(uid);
      match /links/{linkId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && request.resource.data.title is string && request.resource.data.title.size() <= 80
          && request.resource.data.url is string && request.resource.data.url.size() <= 2048
          && request.resource.data.url.matches('^https?://.*')
          && request.resource.data.icon is string && request.resource.data.icon.size() <= 16
          && request.resource.data.order is int && request.resource.data.enabled is bool && request.resource.data.clicks == 0;
        allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','url','icon','enabled','order','updatedAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 80
          && request.resource.data.url is string && request.resource.data.url.size() <= 2048
          && request.resource.data.url.matches('^https?://.*')
          && request.resource.data.order is int && request.resource.data.enabled is bool;
      }
      match /analytics/{eventId} { allow read: if owner(uid); allow write: if false; }
    }
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && validUsernameDoc() && username.matches('^[a-z0-9_]{3,24}$');
      allow update: if signedIn() && resource.data.uid == request.auth.uid && validUsernameDoc();
      allow delete: if false;
    }
    match /publicProfiles/{username} {
      allow read: if resource.data.profilePublished == true;
      allow create, update: if signedIn() && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username
        && request.resource.data.keys().hasOnly(['username','usernameLower','displayName','bio','photoURL','coverURL','category','theme','profilePublished','updatedAt'])
        && request.resource.data.username == username
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.coverURL is string && request.resource.data.coverURL.size() <= 2048
        && request.resource.data.category is string && request.resource.data.theme in ['dark','light']
        && request.resource.data.profilePublished is bool
        && request.resource.data.profilePublished == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profilePublished;
      allow delete: if signedIn() && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
      match /links/{linkId} {
        function profileOwner() { return signedIn() && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid; }
        allow read: if get(/databases/$(database)/documents/publicProfiles/$(username)).data.profilePublished == true;
        allow create, update: if profileOwner() && request.resource.data.keys().hasOnly(['title','url','icon','enabled','order','updatedAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 80
          && request.resource.data.url is string && request.resource.data.url.size() <= 2048
          && request.resource.data.url.matches('^https?://.*')
          && request.resource.data.enabled is bool && request.resource.data.order is int;
        allow delete: if profileOwner();
      }
    }
  }
}
